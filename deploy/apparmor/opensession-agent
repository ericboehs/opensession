#include <tunables/global>

# Model-controlled engine and shell processes inherit this profile. Open Session
# itself stays unconfined so only the coordinator can read systemd credentials.
profile opensession-agent flags=(attach_disconnected,mediate_deleted) {
  file,
  network,
  unix,
  dbus,
  signal,
  ptrace (read, trace, readby, tracedby) peer=opensession-agent,

  # The systemd USER manager is unconfined, and a transient unit it creates for
  # us does not inherit this profile, so reaching it escapes every deny below:
  # `systemd-run --user --pipe /bin/sh -c ...` yields an unconfined process at
  # this same uid that can read the store and the coordinator's credential
  # mount. Denying the binaries is not enough (busctl or a raw D-Bus client
  # reaches the same manager), so the control channels themselves are closed.
  # Cost: a confined agent shell can no longer start work outside its own
  # cgroup this way. Coordinator-side tooling still can, because the
  # coordinator is deliberately unconfined.
  deny /run/systemd/private rwkl,
  deny /run/user/[0-9]*/systemd/private rwkl,
  deny /run/user/[0-9]*/bus rwkl,
  deny unix (connect, send, receive) addr="@/run/systemd/private*",
  deny unix (connect, send, receive) addr="@/run/user/[0-9]*/systemd/private*",
  deny unix (connect, send, receive) addr="@/tmp/dbus-*",
  deny dbus bus=session,
  deny dbus bus=system peer=(name=org.freedesktop.systemd1),
  deny /{usr/,}bin/systemd-run x,
  deny /{usr/,}bin/systemctl x,
  deny /{usr/,}bin/busctl x,

  # Container daemons are root-equivalent brokers, for the same reason the user
  # systemd manager was: they run as root and do filesystem work on our behalf,
  # so `docker run -v /var/lib/opensession:/x` hands back the key and the store
  # no matter what the path rules below say. On this host the service user is
  # in the `docker` group, so the socket is genuinely reachable. Container work
  # stays coordinator-side (src/server/sandbox), which is unconfined by design.
  deny /var/run/docker.sock rwkl,
  deny /run/docker.sock rwkl,
  deny /var/run/containerd/containerd.sock rwkl,
  deny /run/containerd/containerd.sock rwkl,
  deny /run/podman/podman.sock rwkl,
  deny /run/user/[0-9]*/podman/podman.sock rwkl,
  deny /run/buildkit/** rwkl,
  deny /{usr/,}bin/docker x,

  deny /run/credentials/** r,
  deny /var/lib/opensession/** rwklx,
  deny /etc/apparmor.d/** rwklx,
  deny /usr/bin/sudo x,
  deny @{PROC}/[0-9]*/environ r,
  deny @{PROC}/[0-9]*/mem rw,
  deny @{PROC}/[0-9]*/fd/** rwkl,
  deny @{PROC}/[0-9]*/task/[0-9]*/environ r,
  deny @{PROC}/[0-9]*/task/[0-9]*/mem rw,
  deny @{PROC}/[0-9]*/task/[0-9]*/fd/** rwkl,
  deny @{PROC}/[0-9]*/root/run/credentials/** r,
  deny @{PROC}/[0-9]*/root@{HOME}/.opensession.env rwkl,
  deny @{PROC}/[0-9]*/root@{HOME}/.opensession-mcp-oauth.json* rwkl,
  deny @{PROC}/[0-9]*/root@{HOME}/.opensession-mcp-relay.json* rwkl,
  deny ptrace (read, trace) peer=unconfined,
  deny signal (send) peer=unconfined,

  deny @{HOME}/.opensession.env rwkl,
  deny @{HOME}/.opensession-mcp-oauth.json* rwkl,
  deny @{HOME}/.opensession-mcp-relay.json* rwkl,
}
