{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackstageAuditLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "logs:PutRetentionPolicy"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:486029010931:log-group:/tella/backstage/*"
      ]
    },
    {
      "Sid": "BackstageAuditLogDiscovery",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups"],
      "Resource": "*"
    }
  ]
}
