#!/bin/bash
# PID 1 for OpenSession preview microVMs (Firecracker guests).
#
# The rootfs is a `docker export` of the preview-pool golden image, so there
# is no systemd — this script is the whole boot: mount the API filesystems,
# bring up networking (eth0 itself is configured by the kernel `ip=` boot
# arg; we only add lo + DNS), start the exec agent (control.py, the same
# daemon the Lambda MicroVM image uses) and the dev server, then sit as a
# zombie reaper. The dev server is started HERE (not via the agent) so a
# fresh boot self-warms and the golden snapshot captures it mid-run.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/local/bun/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sys /sys
mountpoint -q /dev || mount -t devtmpfs dev /dev
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /dev/shm 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
chmod 1777 /tmp

BB=/opt/bks/busybox
$BB hostname bks-preview
swapon /swapfile 2>/dev/null || true
$BB ip link set lo up 2>/dev/null || true
# Public resolvers: the exported image carries docker's 127.0.0.11 stub.
printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' > /etc/resolv.conf

# Exec agent (host reaches it on the tap IP :8080). Runs as ubuntu so file
# operations match the workspace ownership.
setpriv --reuid 1000 --regid 1000 --init-groups \
  env HOME=/home/ubuntu USER=ubuntu LOGNAME=ubuntu PATH="$PATH" \
  python3 /opt/bks/control.py > /var/log/bks-agent.log 2>&1 &

# Root agent on :8081 for host-management ops the ubuntu agent can't do —
# above all `date -s` after a snapshot restore (the guest wakes at
# snapshot-time; AWS SigV4 rejects >5min skew, so claims resync first).
env BKS_CONTROL_PORT=8081 python3 /opt/bks/control.py > /var/log/bks-root-agent.log 2>&1 &

# Dev server, detached from any console (stdin closed: next dev exits on
# stdin EOF — same lesson as the Daytona backend).
setpriv --reuid 1000 --regid 1000 --init-groups \
  env HOME=/home/ubuntu USER=ubuntu LOGNAME=ubuntu PATH="$PATH" \
      WEBAPP_PORT=3300 BACKSTAGE_BOOT_MODE=snapshot-restore \
  bash -c 'cd /home/ubuntu/preview-workspace && exec bash .opensession/start.sh' \
  < /dev/null > /tmp/boot.log 2>&1 &

# PID 1 duties: reap zombies forever.
while :; do wait -n 2>/dev/null || sleep 2; done
