#!/bin/bash
# PID 1 for general OpenSession Firecracker sandboxes.
#
# Unlike bks-init (the preview-pool golden), this starts no app and contains no
# repo-specific credential seeding. The host/model reaches the guest only
# through the structured control API on 8080; 8081 is reserved for lifecycle
# operations such as correcting the clock after snapshot restore.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/local/bun/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sys /sys
mountpoint -q /dev || mount -t devtmpfs dev /dev
mkdir -p /dev/pts /dev/shm /run /tmp /home/ubuntu
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /dev/shm 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
chmod 1777 /tmp

BB=/opt/bks/busybox
$BB hostname opensession-sandbox
swapon /swapfile 2>/dev/null || true
$BB ip link set lo up 2>/dev/null || true
printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' > /etc/resolv.conf

setpriv --reuid 1000 --regid 1000 --init-groups \
  env HOME=/home/ubuntu USER=ubuntu LOGNAME=ubuntu PATH="$PATH" \
  python3 /opt/bks/control.py > /var/log/bks-agent.log 2>&1 &

env BKS_CONTROL_PORT=8081 python3 /opt/bks/control.py \
  > /var/log/bks-root-agent.log 2>&1 &

while :; do wait -n 2>/dev/null || sleep 2; done
