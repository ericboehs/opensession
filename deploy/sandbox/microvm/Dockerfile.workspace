# Minimal filesystem image for host-engine Firecracker workspaces.
#
# This is deliberately separate from deploy/sandbox/Dockerfile:
# - no engine or Claude CLI
# - no Open Session runner source or dependencies
# - no model/provider account directories
#
# The host owns the model loop and credentials. The guest contains only the
# tools reachable through opensession-workspace plus a practical code-editing
# baseline. refresh-sandbox-golden.sh exports this image into the ext4 golden.
FROM ubuntu:24.04

ARG BUN_VERSION=1.4.0
ARG NODE_MAJOR=24

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        coreutils \
        curl \
        file \
        findutils \
        git \
        gnupg \
        iproute2 \
        jq \
        lsof \
        procps \
        python3 \
        ripgrep \
        sed \
        sqlite3 \
        sudo \
        unzip \
        util-linux \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Node is common repo plumbing even when Bun is the package manager/runtime.
RUN curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install \
        | BUN_INSTALL=/usr/local/bun bash -s "bun-v${BUN_VERSION}" \
    && ln -s /usr/local/bun/bin/bun /usr/local/bin/bun \
    && ln -s /usr/local/bun/bin/bun /usr/local/bin/bunx \
    && test "$(bun --version)" = "${BUN_VERSION}"

# ubuntu:24.04 ships uid/gid 1000. The control API runs as this user, and the
# bootstrap may use passwordless sudo to repair/create its home.
RUN mkdir -p /home/ubuntu \
    && chown -R ubuntu:ubuntu /home/ubuntu \
    && printf 'ubuntu ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/ubuntu \
    && chmod 0440 /etc/sudoers.d/ubuntu

ENV HOME=/home/ubuntu \
    PATH=/home/ubuntu/.local/bin:/usr/local/bun/bin:/usr/local/bin:/usr/bin:/bin

USER ubuntu
WORKDIR /home/ubuntu
CMD ["sleep", "infinity"]
