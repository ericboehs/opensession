[Unit]
# Re-arms the non-persistent host state the preview stack needs after a
# reboot: the docker IMDS drop rule (setup-host.sh) — the XFS clone store
# mounts via its fstab entry (loop,nofail), /dev/kvm group access is durable
# (kvm group membership + default udev), and per-clone taps/NAT are created
# by clone.sh at spawn. Install:
#   sudo cp deploy/sandbox/microvm/bks-host-setup.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable bks-host-setup
Description=OpenSession preview host setup (IMDS rule re-arm)
After=docker.service network-online.target
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /home/ubuntu/projects/tella-backstage/deploy/sandbox/setup-host.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
