{
  "manifest_version": 3,
  "name": "OpenSession",
  "version": "0.1.0",
  "description": "Capture context from the Tella webapp and kick off OpenSession agent sessions. Internal Tella tool — not for the Web Store.",
  "minimum_chrome_version": "116",
  "icons": {
    "128": "icons/icon.png"
  },
  "action": {
    "default_title": "OpenSession"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "https://os.tella.dev/*",
    "https://*.tella.tv/*",
    "https://*.tella.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
