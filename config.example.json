{
  "_comments": [
    "Copy to ~/.opensession/config.json or point OPENSESSION_CONFIG at it.",
    "Environment variables override config values. Repositories are authoritative: when `repos` is present, only those entries are registered.",
    "With no `repos` configured, a server install registers this OpenSession checkout itself as a shared `opensession` repo. Set `repos` for real team projects.",
    "External integrations and instance seed routines are opt-in (`enabled: true`)."
  ],
  "server": {
    "host": "127.0.0.1",
    "port": 3850,
    "webhookPort": 3848,
    "publicBaseUrl": "https://sessions.example.com",
    "previewHost": "preview.example.com",
    "caddyAdmin": "http://localhost:2019"
  },
  "paths": {
    "claudeBin": "claude",
    "opencodeBin": "opencode",
    "worktreesDir": "/srv/opensession/worktrees",
    "mcpConfig": "/srv/opensession/mcp-config.json"
  },
  "cloud": {
    "upstream": "https://sessions.example.com",
    "token": "optional-local-client-bearer-token"
  },
  "branding": {
    "productName": "OpenSession",
    "productMark": "OS"
  },
  "persona": {
    "name": "Assistant",
    "company": "Acme",
    "product": "Acme Widget"
  },
  "repos": {
    "widget": {
      "label": "Widget",
      "description": "Acme's main product application and API.",
      "repo": "/srv/repos/widget",
      "wtPrefix": "widget",
      "defaultBranch": "main",
      "ghRepo": "acme/widget",
      "default": true,
      "icon": "assets/widget-icon.png",
      "worktreeSetup": "git submodule update --init --depth 1",
      "depsInstall": "bun install",
      "previewCommand": "/srv/opensession/bin/start-widget-preview",
      "warmCachePaths": ["dist/generated-client.js"],
      "previewAwsProfile": "widget-dev",
      "deploymentTracking": true,
      "securityInstructions": "Read SECURITY.md before triaging findings; run bun test for changed packages.",
      "prCacheOpenLimit": 100,
      "prCacheRecentLimit": 500
    },
    "opensession": {
      "label": "OpenSession",
      "description": "This OpenSession installation.",
      "repo": "/srv/opensession",
      "wtPrefix": "opensession",
      "defaultBranch": "main",
      "ghRepo": "acme/opensession",
      "sharedCheckout": true
    }
  },
  "identity": {
    "defaultTimezone": "UTC",
    "team": [
      {
        "name": "Alice Example",
        "email": "alice@example.com",
        "aliases": ["alice"],
        "slackId": "U012345",
        "github": "alice",
        "linearEmails": ["alice@example.com"],
        "timezone": "UTC"
      }
    ],
    "slackNames": {}
  },
  "policy": {
    "githubWriteOwners": ["acme"],
    "githubBotLogins": ["acme-automation"]
  },
  "integrations": {
    "github": {
      "enabled": false,
      "userPrAuth": false,
      "oauthClientId": "",
      "mentionHandles": ["assistant", "acme-automation"],
      "previewEnvironment": "Preview"
    },
    "slack": {"enabled": false},
    "linear": {
      "enabled": false,
      "oauthRedirectUrl": "https://sessions.example.com/oauth/callback"
    },
    "plain": {
      "enabled": false,
      "mentionHandle": "assistant",
      "linearTeamKey": "WIDGET",
      "workspaceId": "w_01ABCDEFGHJKMNPQRSTVWXYZ00",
      "apiUrl": "https://core-api.uk.plain.com/graphql/v1"
    },
    "stripe": {"enabled": false},
    "grafana": {"enabled": false},
    "accountHealth": {
      "notifyUser": "alice",
      "slackChannel": "D012345"
    },
    "seeds": {
      "enabled": false,
      "actions": [
        {
          "id": "act-seed-maintenance",
          "name": "Run maintenance",
          "kind": "repo",
          "repo": "widget",
          "scriptPath": "scripts/maintenance.ts",
          "inputs": [],
          "confirm": true
        }
      ],
      "automations": [
        {
          "name": "Weekly dependency review",
          "prompt": "Review dependency updates in the configured repository. Report actionable upgrades and open a focused PR only when the repository policy permits it.",
          "schedule": "0 9 * * 1",
          "mode": "code",
          "repo": "widget",
          "eventKey": "seed:weekly-dependency-review",
          "mcpServers": []
        }
      ]
    }
  }
}
