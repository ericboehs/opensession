#!/usr/bin/env bash
# gh-guard git shim: intercepts `git push` from agent runs and blocks pushes
# to remotes outside the allowed owners (default "tellahq"); every other git
# subcommand execs the real git untouched. Sibling of ./gh — see that file's
# header for the incidents and policy. Local-path remotes are allowed; unknown
# hosts and unresolvable remotes are blocked (fail-closed).
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

find_real() {
  local IFS=:
  local d
  for d in $PATH; do
    [ "$d" = "$SELF_DIR" ] && continue
    [ -x "$d/$1" ] && { printf '%s\n' "$d/$1"; return 0; }
  done
  return 1
}

REAL_GIT="$(find_real git)" || { echo "gh-guard: no real git on PATH" >&2; exit 127; }

# Split global options (before the subcommand) from the rest; we need the
# globals (-C dir etc.) to resolve remotes in the right repo.
GLOBALS=()
SUB=""
REST=()
expect_val=""
for a in "$@"; do
  if [ -n "$SUB" ]; then REST+=("$a"); continue; fi
  if [ -n "$expect_val" ]; then GLOBALS+=("$a"); expect_val=""; continue; fi
  case "$a" in
    -C|-c|--git-dir|--work-tree|--namespace|--exec-path|--super-prefix)
      GLOBALS+=("$a"); expect_val=1;;
    -*) GLOBALS+=("$a");;
    *) SUB="$a";;
  esac
done

if [ "$SUB" != "push" ]; then
  if [ "${GH_GUARD_TEST:-}" = "1" ]; then echo "ALLOW"; exit 0; fi
  exec "$REAL_GIT" "$@"
fi

allow() {
  if [ "${GH_GUARD_TEST:-}" = "1" ]; then echo "ALLOW"; exit 0; fi
  exec "$REAL_GIT" "$@"
}

block() {
  local reason="$1"
  local dir="$HOME/.opensession-audit"
  mkdir -p "$dir" 2>/dev/null || true
  printf '%s BLOCK git push %s :: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" "$*" \
    >>"$dir/gh-guard.log" 2>/dev/null || true
  if [ "${GH_GUARD_TEST:-}" = "1" ]; then echo "BLOCK $reason"; exit 1; fi
  cat >&2 <<EOF
gh-guard: BLOCKED git push ($reason).
Agent runs may not push to GitHub repos outside [$ALLOWED_OWNERS] — no forks,
branches, or PRs on third-party or public repos, ever. If an upstream
contribution seems warranted, describe it in your summary/note and let a
human decide and post it themselves.
EOF
  exit 1
}

ALLOWED_OWNERS="${OPENSESSION_GH_ALLOWED_OWNERS:-tellahq}"
[ "${OPENSESSION_GH_GUARD_ALLOW:-}" = "1" ] && allow "$@"

owner_allowed() {
  local owner
  owner="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  local IFS=,
  local o
  for o in $ALLOWED_OWNERS; do
    [ "$owner" = "$(printf '%s' "$o" | tr '[:upper:]' '[:lower:]')" ] && return 0
  done
  return 1
}

# First non-option arg after `push` is the remote name or URL. Skip the
# value of options that take one.
CAND=""
expect_val=""
for a in "${REST[@]+"${REST[@]}"}"; do
  if [ -n "$expect_val" ]; then expect_val=""; continue; fi
  case "$a" in
    -o|--push-option|--receive-pack|--exec) expect_val=1;;
    --repo=*) CAND="${a#--repo=}"; break;;
    -*) ;;
    *) CAND="$a"; break;;
  esac
done

URL=""
case "$CAND" in
  "")
    # No explicit remote: git pushes to the current branch's upstream remote.
    up="$("$REAL_GIT" ${GLOBALS[@]+"${GLOBALS[@]}"} rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
    remote="${up%%/*}"
    [ -z "$remote" ] || [ "$remote" = "$up" ] && remote="origin"
    URL="$("$REAL_GIT" ${GLOBALS[@]+"${GLOBALS[@]}"} remote get-url "$remote" 2>/dev/null || true)"
    ;;
  *://*|*@*:*)
    URL="$CAND";;
  /*|./*|../*|file:*)
    allow "$@";;
  *)
    URL="$("$REAL_GIT" ${GLOBALS[@]+"${GLOBALS[@]}"} remote get-url "$CAND" 2>/dev/null || true)"
    ;;
esac

[ -z "$URL" ] && block "cannot resolve push target"

case "$URL" in
  /*|./*|../*|file:*) allow "$@";;
  *github.com*)
    v="$URL"
    v="${v#https://}"; v="${v#http://}"; v="${v#ssh://}"; v="${v#git@}"
    v="${v#github.com:}"; v="${v#github.com/}"
    owner="${v%%/*}"
    owner_allowed "$owner" && allow "$@"
    block "push to $owner"
    ;;
  *) block "push to non-github remote $URL";;
esac
