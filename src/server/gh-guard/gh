#!/usr/bin/env bash
# gh-guard: blocks GitHub writes to repos outside the allowed owners from
# agent runs. opencodeEnv() prepends this directory to PATH for every engine
# server, so all Bash-tool `gh` calls resolve here first.
#
# Why: two public-repo incidents — vercel-labs/deepsec#114 (issue opened
# 2026-07-19) and TomGranot/tella-to-youtube#1 (fork + PR, 2026-07-21) — both
# by runs that carried the prompt-level "public repositories require
# confirmation" rule. Prompt-only enforcement failed; this is the tool-layer
# gate. It is a guardrail against earnest-agent accidents, not a security
# boundary (the token's scope is the real ceiling).
#
# Policy:
#   - `repo fork` and `gist create/edit/delete` are always blocked.
#   - `repo create` requires --private.
#   - Mutating verbs in repo-scoped families (issue/pr/release/...) resolve
#     their target repo (--repo/-R flag, else `git remote get-url origin`) and
#     are blocked unless the owner is in OPENSESSION_GH_ALLOWED_OWNERS
#     (comma-separated, default "tellahq"). Unresolvable target = blocked.
#   - `api` calls with a mutating method (or -f/-F/--field/--input, which
#     default to POST) must target repos/<allowed-owner>/…; graphql passes
#     (reads and mutations are indistinguishable at the CLI layer).
#   - Reads pass through untouched.
#
# OPENSESSION_GH_GUARD_ALLOW=1 bypasses (human-approved runs only; never
# mention this in agent-facing text). GH_GUARD_TEST=1 prints the decision
# (ALLOW/BLOCK reason) instead of exec'ing — used by zz-gh-guard.test.ts.
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

find_real() {
  local IFS=:
  local d
  for d in $PATH; do
    [ "$d" = "$SELF_DIR" ] && continue
    [ -x "$d/$1" ] && { printf '%s\n' "$d/$1"; return 0; }
  done
  return 1
}

REAL_GH="$(find_real gh)" || { echo "gh-guard: no real gh on PATH" >&2; exit 127; }
# Bypass the sibling git shim when resolving remotes (matters in test mode;
# harmless in production where the shim would exec real git anyway).
REAL_GIT="$(find_real git)" || REAL_GIT="git"

allow() {
  if [ "${GH_GUARD_TEST:-}" = "1" ]; then echo "ALLOW"; exit 0; fi
  exec "$REAL_GH" "$@"
}

log_block() {
  local dir="$HOME/.opensession-audit"
  mkdir -p "$dir" 2>/dev/null || return 0
  printf '%s BLOCK gh %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$dir/gh-guard.log" 2>/dev/null || true
}

block() {
  local reason="$1"
  log_block "$reason :: $ORIG_ARGS"
  if [ "${GH_GUARD_TEST:-}" = "1" ]; then echo "BLOCK $reason"; exit 1; fi
  cat >&2 <<EOF
gh-guard: BLOCKED ($reason).
Agent runs may not write to GitHub repos outside [$ALLOWED_OWNERS] — no
issues, comments, PRs, forks, or pushes on third-party or public repos, ever
(real incidents: vercel-labs/deepsec#114, TomGranot/tella-to-youtube#1).
Do not attempt to work around this. If an upstream contribution or bug report
seems genuinely warranted, describe it in your summary/note and let a human
decide and post it themselves.
EOF
  exit 1
}

ORIG_ARGS="$*"
ALLOWED_OWNERS="${OPENSESSION_GH_ALLOWED_OWNERS:-tellahq}"
[ "${OPENSESSION_GH_GUARD_ALLOW:-}" = "1" ] && allow "$@"

owner_allowed() { # $1 = owner (bare) — case-insensitive membership test
  local owner
  owner="$(printf '%s' "${1%%/*}" | tr '[:upper:]' '[:lower:]')"
  local IFS=,
  local o
  for o in $ALLOWED_OWNERS; do
    [ "$owner" = "$(printf '%s' "$o" | tr '[:upper:]' '[:lower:]')" ] && return 0
  done
  return 1
}

# owner_of_repoarg "OWNER/REPO" | "github.com/OWNER/REPO" | full URL → OWNER
owner_of_repoarg() {
  local v="$1"
  v="${v#https://}"; v="${v#http://}"; v="${v#ssh://}"; v="${v#git@}"
  v="${v#github.com:}"; v="${v#github.com/}"
  printf '%s\n' "${v%%/*}"
}

# Resolve the target repo owner for a repo-scoped command: --repo/-R flag
# wins, else origin remote of the cwd. Empty output = unresolvable.
resolve_owner() {
  local prev="" a
  for a in "$@"; do
    case "$prev" in
      --repo|-R) owner_of_repoarg "$a"; return 0;;
    esac
    case "$a" in
      --repo=*) owner_of_repoarg "${a#--repo=}"; return 0;;
      -R=*) owner_of_repoarg "${a#-R=}"; return 0;;
    esac
    prev="$a"
  done
  local url
  url="$("$REAL_GIT" remote get-url origin 2>/dev/null || true)"
  case "$url" in
    *github.com*) owner_of_repoarg "$url";;
    *) printf '\n';;
  esac
}

# First two non-flag args = command family + verb.
FAMILY="" VERB=""
for a in "$@"; do
  case "$a" in
    -*) continue;;
  esac
  if [ -z "$FAMILY" ]; then FAMILY="$a"; elif [ -z "$VERB" ]; then VERB="$a"; break; fi
done

case "$FAMILY" in
  gist)
    case "$VERB" in
      list|view|clone) allow "$@";;
      *) block "gist writes are disabled (public pastebin risk)";;
    esac
    ;;
  repo)
    case "$VERB" in
      fork) block "forking is disabled for agent runs";;
      create)
        for a in "$@"; do [ "$a" = "--private" ] && allow "$@"; done
        block "repo create requires --private"
        ;;
      list|view|clone) allow "$@";;
      *)
        owner="$(resolve_owner "$@")"
        [ -n "$owner" ] && owner_allowed "$owner" && allow "$@"
        block "repo $VERB on ${owner:-unresolvable repo}"
        ;;
    esac
    ;;
  issue|pr|release|label|run|workflow|cache|secret|variable|project|ruleset)
    case "$VERB" in
      list|view|status|diff|checks|download|watch|verify|checkout) allow "$@";;
      *)
        owner="$(resolve_owner "$@")"
        [ -n "$owner" ] && owner_allowed "$owner" && allow "$@"
        block "$FAMILY $VERB on ${owner:-unresolvable repo}"
        ;;
    esac
    ;;
  api)
    method="" has_fields=0 path="" prev=""
    for a in "$@"; do
      case "$prev" in
        --method|-X) method="$a"; prev="$a"; continue;;
        -f|-F|--field|--raw-field|--input) has_fields=1; prev="$a"; continue;;
        -H|--header|--hostname|--jq|-q|--template|-t|--cache|-p|--preview) prev="$a"; continue;;
      esac
      case "$a" in
        --method=*|-X=*) method="${a#*=}";;
        --field=*|--raw-field=*|--input=*) has_fields=1;;
        -f|-F|--field|--raw-field|--input) has_fields=1;;
        api|-*) ;;
        *) [ -z "$path" ] && path="$a";;
      esac
      prev="$a"
    done
    method="$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')"
    if [ -z "$method" ] && [ "$has_fields" = 1 ]; then method="POST"; fi
    case "$method" in
      ""|GET|HEAD) allow "$@";;
    esac
    path="${path#/}"
    case "$path" in
      graphql) allow "$@";;
      repos/*)
        owner="${path#repos/}"; owner="${owner%%/*}"
        owner_allowed "$owner" && allow "$@"
        block "api $method on $path"
        ;;
      *) block "api $method on ${path:-unknown path}";;
    esac
    ;;
  *) allow "$@";;
esac
