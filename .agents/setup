#!/usr/bin/env bash
# One-shot worktree provisioning for the Open Session self-preview
# (the `.agents/setup` lifecycle hook — docs/repo-lifecycle.md).
#
# The preview flow runs this once per worktree (stamped by the caller — see
# src/server/preview.ts setupStampPath) before the first start.sh, with the
# same env contract. Sandboxed previews run it at workspace materialization
# instead. Keep it idempotent and non-destructive: the stamp is written even
# on failure, and in shared-checkout self-sessions cwd is a checkout that a
# live server may be running from.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

case ":$PATH:" in
	*":$HOME/.bun/bin:"*) ;;
	*) export PATH="$HOME/.bun/bin:$PATH" ;;
esac
command -v bun >/dev/null 2>&1 || {
	echo "ERROR: bun not found on PATH ($PATH)" >&2
	exit 1
}

# Dependencies for a fresh worktree; a no-op when node_modules is current.
bun install --frozen-lockfile
