{
  "name": "os1-mac",
  "productName": "OS¹",
  "version": "0.3.5",
  "description": "macOS desktop app for OS¹ — a thin shell around https://os.tella.dev",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "vendor:opencode": "sh scripts/fetch-opencode.sh",
    "dist": "bun run vendor:opencode && electron-builder --mac",
    "postinstall": "sh scripts/brand-dev-electron.sh || true"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.0.12"
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "dmg-license"
  ]
}
