{
  "name": "os1-mac",
  "productName": "OS¹",
  "version": "0.3.8",
  "description": "macOS desktop shell for an OpenSession server",
  "private": true,
  "license": "Apache-2.0",
  "main": "src/main.js",
  "opensession": {
    "defaultServer": "http://127.0.0.1:3850/"
  },
  "scripts": {
    "start": "electron .",
    "vendor:opencode": "sh scripts/fetch-opencode.sh",
    "vendor:bun": "sh scripts/fetch-bun.sh",
    "vendor:server": "bun run scripts/build-server-sidecar.ts",
    "dist": "bun run vendor:opencode && bun run vendor:bun && bun run vendor:server && electron-builder --mac",
    "postinstall": "sh scripts/brand-dev-electron.sh || true"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.0.12"
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "dmg-license"
  ]
}
