{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "plain": {
      "command": "bun",
      "args": [
        "run",
        "/path/to/plain-mcp/src/index.ts"
      ],
      "env": {
        "PLAIN_API_KEY": "<your-plain-api-key>"
      }
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "workos": {
      "command": "/path/to/workos-mcp"
    },
    "tinybird": {
      "type": "http",
      "url": "https://mcp.tinybird.co?token=<your-tinybird-token>"
    },
    "circle": {
      "type": "http",
      "url": "https://app.circle.so/api/mcp"
    },
    "dub": {
      "type": "http",
      "url": "https://mcp.dub.sh/mcp/dub-links",
      "headers": {
        "Mcp-Dub-Token": "<your-dub-api-key>"
      }
    }
  }
}
