[Unit]
Description=OpenSession - agent session dashboard
After=network.target

[Service]
# .cargo/bin: opencodeEnv()/host-client pass this PATH straight through to
# engine subprocesses, and tella-fusion code sessions need cargo/rustup on it
# to build/validate Rust (dev pipeline runs `cargo watch`). Interactive shells
# get it from the login profile; the service must carry it explicitly.
Environment="PATH=/home/ubuntu/.cargo/bin:/home/ubuntu/.bun/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/tella-backstage
EnvironmentFile=/home/ubuntu/.opensession.env
Environment="NODE_ENV=production"
# --hot: edits to source hot-reload in-process (request handlers and the
# session-control registry refresh; WebSocket clients and in-flight runs
# survive) instead of restarting and dropping every session. One-time setup
# (agents, schedulers, timers) is guarded against double-start; long-lived agent
# loop code still needs a real `systemctl restart`, which is now graceful.
ExecStart=/home/ubuntu/.bun/bin/bun --hot run opensession.ts
Restart=always
RestartSec=5
# Give graceful shutdown time to drain in-flight runs (SHUTDOWN_DRAIN_MS, 60s)
# before systemd escalates to SIGKILL. Must stay above SHUTDOWN_DRAIN_MS (60s) +
# a buffer for the rest of shutdown, or systemd kills the process mid-drain.
# Drain was cut 120s→60s (2026-07-11) for snappier restarts: the run journal
# resumes anything still mid-turn on the next boot, and a resumed run now self-
# heals transient failures via the fallback graph — so a shorter drain trades a
# little redo work for a much faster restart, not lost work.
TimeoutStopSec=80
# SIGTERM the bun parent ONLY — not the whole cgroup. The default
# (KillMode=control-group) SIGTERMs every child too, so on restart the Claude
# subprocesses die (exit 143) the instant shutdown begins — before bun's graceful
# drain can run, and before the run journal can do its job. Worse, a loop that
# catches that kill (e.g. github auto-fix) marks itself "done" and defeats its own
# restart recovery. With `mixed`, only bun gets SIGTERM; it drains in-flight runs
# (children keep working) and exits, then systemd SIGKILLs any leftovers after
# TimeoutStopSec. This is what makes the graceful-drain + journal-resume design
# actually take effect.
KillMode=mixed
# Agent runs are driven by untrusted text (customer tickets); none of them
# should be able to mint EC2 instance-role credentials from the metadata
# endpoint. eBPF egress filter — covers every child the service spawns.
# Remove if a session ever legitimately needs the role.
IPAddressDeny=169.254.169.254/32

[Install]
WantedBy=multi-user.target
